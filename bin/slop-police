#!/bin/sh
# Usage: bin/slop-police [--base <ref>] [--repo <dir>] [--config <dir>] [--json <file>]
set -eu
export PYTHONPATH="$(cd "$(dirname "$0")/.." && pwd)${PYTHONPATH:+:$PYTHONPATH}"
# -P leaves the working folder off sys.path: a checkout's own slop_police or json.py must not run as the engine.
exec python3 -P -m slop_police "$@"
